# ==============================================================================
# CertiChain Environment Configuration Template (.env.example)
# Duplicate this file as '.env' and provide your custom environment parameters.
# NEVER commit your real '.env' file or production secrets to source control.
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Authentication & Session Security
# Generate a secure 32+ character random string for production
JWT_SECRET=replace_with_a_secure_jwt_secret_key_at_least_32_chars_long
JWT_EXPIRES_IN=24h

# Database Configuration (MongoDB & Mongoose)
# Local instance or MongoDB Atlas URI. If omitted or unreachable, CertiChain
# automatically falls back to its resilient local persistence engine.
MONGODB_URI=mongodb://localhost:27017/certichain

# Private Document Storage Vault
# Offline directory used to store generated academic diploma PDF byte files.
# NEVER expose this directory via public HTTP routing.
STORAGE_DIR=./server/storage/certificates

# Initial University Administrator Setup (npm run setup:admin)
# Used by the CLI bootstrap script to provision the root university admin.
ADMIN_NAME=Dr. Eleanor Vance
ADMIN_EMAIL=admin@stanford.edu
ADMIN_PASSWORD=ReplaceWithStrongPassword@2026
ADMIN_INSTITUTION=Stanford University

# Blockchain & Smart Contract Configuration
# Contract address deployed on Sepolia Testnet or local Hardhat/Ganache EVM
VITE_CERTICHAIN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_DEFAULT_CHAIN_ID=11155111
RPC_URL=https://rpc.sepolia.org
